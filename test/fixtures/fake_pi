#!/usr/bin/env ruby
# frozen_string_literal: true

#
# Fake pi for Letsdo::Backends::Pi / Letsdo::Agent / Letsdo::CLI tests.
#
# Behaves like pi --mode json for deterministic scenarios:
#   - accepts the same arguments: --mode json [flags] <prompt>;
#   - writes a line-by-line JSON event stream to stdout, like real pi;
#   - by default exits with code 0 (or FAKE_PI_EXIT).
#
# Control (via the environment):
#   FAKE_PI_EXIT        exit code (default 0)
#   FAKE_PI_ARGV_FILE   path: if set, ARGV.join("|") is written there —
#                       to check the argument order (flags, prompt)
#   FAKE_PI_SCENARIO    event stream contents:
#                       default — text + a successful bash call;
#                       error   — text + a bash call with an error (isError);
#                       big     — text + a bash call with a big output
#                                  (result truncation check);
#                       stub    — only toolcall_start without execution
#                                  events ("⚙ name" fallback check).
#
#   FAKE_PI_READY_FILE  path: once set, the file is written right before
#                       the final sleep — lets tests wait until the fake pi
#                       is fully booted before pausing/terminating it.
#

require 'json'

if (argv_file = ENV['FAKE_PI_ARGV_FILE'])
  File.open(argv_file, 'a') { |file| file.puts(ARGV.join('|')) }
end

def toolcall_start(id, name)
  {
    'type' => 'message_update',
    'usage' => { 'input' => 0, 'output' => 0 },
    'assistantMessageEvent' => { 'type' => 'toolcall_start', 'contentIndex' => 1 },
    'id' => id,
    'toolName' => name
  }
end

def toolcall_end(id, name, args)
  {
    'type' => 'message_update',
    'usage' => { 'input' => 0, 'output' => 0 },
    'assistantMessageEvent' => {
      'type' => 'toolcall_end',
      'contentIndex' => 1,
      'toolCall' => { 'id' => id, 'name' => name, 'arguments' => args }
    }
  }
end

def execution_start(id, name, command)
  { 'type' => 'tool_execution_start', 'toolCallId' => id, 'toolName' => name, 'args' => { 'command' => command } }
end

def execution_end(id, name, result, is_error)
  { 'type' => 'tool_execution_end', 'toolCallId' => id, 'toolName' => name, 'result' => result, 'isError' => is_error }
end

text_deltas = [
  { 'type' => 'message_update', 'assistantMessageEvent' => { 'type' => 'text_delta', 'delta' => 'Hello, ' } },
  { 'type' => 'message_update' },
  { 'type' => 'message_update', 'assistantMessageEvent' => { 'type' => 'text_delta', 'delta' => '' } },
  { 'type' => 'message_update', 'assistantMessageEvent' => { 'type' => 'text_delta', 'delta' => 'world!' } }
]

base_events = [
  'this is not JSON',
  { 'type' => 'other_event', 'data' => 1 }
]

scenario = ENV.fetch('FAKE_PI_SCENARIO', 'default')

events =
  case scenario
  when 'default', ''
    base_events + text_deltas + [
      toolcall_start('call-1', 'bash'),
      toolcall_end('call-1', 'bash', { 'command' => 'ls -la' }),
      execution_start('call-1', 'bash', 'ls -la'),
      execution_end('call-1', 'bash',
                    {
                      'content' => [{ 'type' => 'text', 'text' => "total 8\ndrwxr-xr-x  root root\n" }],
                      'details' => {}
                    },
                    false),
      { 'type' => 'agent_end', 'messages' => [] }
    ]
  when 'error'
    base_events + text_deltas + [
      toolcall_start('call-2', 'bash'),
      toolcall_end('call-2', 'bash', { 'command' => 'ls /nonexistent' }),
      execution_start('call-2', 'bash', 'ls /nonexistent'),
      execution_end('call-2', 'bash',
                    { 'content' => [
                      { 'type' => 'text',
                        'text' => "ls: cannot access '/nonexistent': No such file " \
                                  "or directory\nCommand exited with code 2" }
                    ], 'details' => {} },
                    true),
      { 'type' => 'agent_end', 'messages' => [] }
    ]
  when 'big'
    output = (1..300).map { |i| format('line %03d: xyz', i) }.join("\n")
    base_events + text_deltas + [
      toolcall_start('call-3', 'bash'),
      toolcall_end('call-3', 'bash', { 'command' => 'seq 1 300' }),
      execution_start('call-3', 'bash', 'seq 1 300'),
      execution_end('call-3', 'bash',
                    { 'content' => [{ 'type' => 'text', 'text' => "#{output}\n" }], 'details' => {} },
                    false),
      { 'type' => 'agent_end', 'messages' => [] }
    ]
  when 'stub'
    base_events + text_deltas + [
      toolcall_start('call-4', 'bash'),
      { 'type' => 'agent_end', 'messages' => [] }
    ]
  else
    raise "Unknown FAKE_PI_SCENARIO: #{scenario}"
  end

events.each { |event| puts JSON.generate(event) }

if (ready_file = ENV['FAKE_PI_READY_FILE'])
  File.write(ready_file, Process.pid.to_s)
end

sleep Float(ENV.fetch('FAKE_PI_SLEEP', '0'))

exit Integer(ENV.fetch('FAKE_PI_EXIT', '0'))
