#!/usr/bin/env ruby
# frozen_string_literal: true

#
# Fake backlog CLI for Letsdo::BacklogTasks / Letsdo::AgentLoop / Letsdo::CLI
# tests.
#
# Behaves like `backlog task list --assignee <handle> --exclude-status Done
# --json` for deterministic scenarios:
#   - accepts the same arguments after the command name;
#   - writes the same versioned JSON shape ({schemaVersion, kind, tasks});
#   - by default exits with code 0.
#
# Control (via the environment):
#   FAKE_BACKLOG_JSON        path: if set, the JSON printed here is written
#                            to this file instead of stdout (for content
#                            inspection and invalid JSON injection).
#   FAKE_BACKLOG_ARGV_FILE   path: if set, ARGV.join("|") is written there —
#                            to check the arguments (assignee, exclude, json).
#   FAKE_BACKLOG_SCENARIO    output:
#                            open      — <count> open tasks (default 2) in the
#                                        full real task schema;
#                            empty     — no tasks;
#                            sparse    — one task with only an id and one with
#                                        only a title (no optional fields);
#                            weird     — a task list whose entry is not an object;
#                            order     — mixed status/priority/ordinal/id tasks
#                                        for the deterministic sort;
#                            blocked   — one ready, one blocked (unfinished
#                                        dependency) and one ready task;
#                            fail      — exit 1 with an error on stderr;
#                            malformed — stdout is not JSON.
#   FAKE_BACKLOG_COUNT       number of tasks in the open scenario (default 2).
#   FAKE_BACKLOG_DONE_FILE   path: if the file exists, the open scenario
#                            turns into empty — tasks were already served
#                            once (for "N tasks → N runs, then wait" loops).
#   FAKE_BACKLOG_EDIT_FAIL   set to 1 to make `task edit` (TASK-70 write-back)
#                            exit 1 with an error on stderr.
#
# The fake honors --ready like the real CLI: tasks with a non-empty
# dependencies list are treated as not ready and dropped when the flag is
# present. Sorting is left to the caller (the provider sorts the batch).
#

require 'json'

if (argv_file = ENV['FAKE_BACKLOG_ARGV_FILE'])
  File.open(argv_file, 'a') { |file| file.puts(ARGV.join('|')) }
end

# Write-back (TASK-70): `task edit <id> --comment ... --comment-author ...`.
# Recorded above like list calls; FAKE_BACKLOG_EDIT_FAIL=1 makes it fail
# (simulates a missing/renamed task or a broken CLI).
if ARGV[0] == 'task' && ARGV[1] == 'edit'
  if ENV['FAKE_BACKLOG_EDIT_FAIL'] == '1'
    warn 'backlog: edit failed'
    exit 1
  end

  exit 0
end

scenario = ENV.fetch('FAKE_BACKLOG_SCENARIO', 'open')
count = Integer(ENV.fetch('FAKE_BACKLOG_COUNT', '2'))

titles = %w[Alpha Beta Gamma Delta Epsilon]
ready_only = ARGV.include?('--ready')

# One task in the full real schema, with the sort inputs varied by the caller.
def order_task(id, title, status, priority, ordinal)
  {
    'id' => id, 'title' => title, 'status' => status, 'priority' => priority,
    'assignees' => ['@developer'], 'type' => 'task', 'labels' => [],
    'milestone' => nil, 'parentTaskId' => nil, 'ordinal' => ordinal,
    'dependencies' => []
  }
end

# Tasks were already served once → the loop should now see none and wait.
if (done_file = ENV['FAKE_BACKLOG_DONE_FILE'])
  if File.exist?(done_file)
    scenario = 'empty'
  else
    File.write(done_file, 'done')
  end
end

tasks = case scenario
        when 'open', ''
          (1..count).map do |i|
            {
              'id' => "TASK-#{i}",
              'title' => titles[(i - 1) % titles.length],
              'status' => 'To Do',
              'type' => 'task',
              'priority' => nil,
              'assignees' => ['@developer'],
              'reporter' => nil,
              'labels' => [],
              'milestone' => nil,
              'parentTaskId' => nil,
              'ordinal' => 1000 + i,
              'createdAt' => '2026-09-03T15:27:00Z',
              'updatedAt' => '2026-09-03T16:34:00Z'
            }
          end
        when 'empty'
          []
        when 'order'
          [order_task('TASK-A', 'Low', 'To Do', 'low', 10),
           order_task('TASK-B', 'HighLate', 'To Do', 'high', 30),
           order_task('TASK-C', 'HighEarly', 'To Do', 'high', 20),
           order_task('TASK-D', 'HighEarlyTie', 'To Do', 'high', 20),
           order_task('TASK-E', 'InProgressLow', 'In Progress', 'low', 99),
           order_task('TASK-F', 'NoPriority', 'To Do', nil, 1)]
        when 'blocked'
          [{ 'id' => 'TASK-1', 'title' => 'Ready', 'status' => 'To Do',
             'priority' => 'high', 'assignees' => ['@developer'], 'ordinal' => 1,
             'dependencies' => [] },
           { 'id' => 'TASK-2', 'title' => 'Blocked', 'status' => 'To Do',
             'priority' => 'high', 'assignees' => ['@developer'], 'ordinal' => 2,
             'dependencies' => ['TASK-1'] },
           { 'id' => 'TASK-3', 'title' => 'ReadyLow', 'status' => 'To Do',
             'priority' => 'low', 'assignees' => ['@developer'], 'ordinal' => 3,
             'dependencies' => [] }]
        when 'sparse'
          [{ 'id' => 'TASK-1' }, { 'title' => 'No id here' }]
        when 'weird'
          ['not-a-task']
        when 'fail'
          warn 'backlog: boom'
          exit 1
        when 'malformed'
          warn 'backlog: malformed'
          exit 0
        else
          warn "Unknown FAKE_BACKLOG_SCENARIO: #{scenario}"
          exit 2
        end

# --ready drops unfinished tasks: the fake has no dependency graph, so any
# non-empty dependencies list counts as blocked (same as the real CLI's
# "all dependencies completed" filter).
tasks = tasks.reject { |t| t.is_a?(Hash) && !Array(t['dependencies']).empty? } if ready_only

output = JSON.generate({ 'schemaVersion' => 1, 'kind' => 'task-list', 'tasks' => tasks })

if (json_file = ENV['FAKE_BACKLOG_JSON'])
  File.write(json_file, output)
else
  puts(scenario == 'malformed' ? 'this is not json' : output)
end

exit 0
